# direnv: run `direnv allow` once. Personal settings (e.g. AWS_PROFILE) go in .envrc.local.

# Python tools in llm/tools (numpy), created on first entry.
if [ ! -x llm/tools/.venv/bin/python ]; then
  python3 -m venv llm/tools/.venv && llm/tools/.venv/bin/pip install -q numpy
fi
source llm/tools/.venv/bin/activate

# AWS work stays in Frankfurt.
export AWS_REGION=eu-central-1

# docker/dev.sh as dev.sh from anywhere in the repo.
PATH_add docker

source_env_if_exists .envrc.local
